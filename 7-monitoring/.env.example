EDGE_API_URL=https://careconnect.example.org/api/edge
# Store a newly registered device token here; do not commit this file's populated copy.
EDGE_DEVICE_TOKEN=
EDGE_CAMERA_SOURCE=0
# Alternatives: rtsp://camera-host/stream, /dev/video0, picamera2 (CSI; Raspberry Pi only)
EDGE_POSE_MODEL=/opt/careconnect-edge/models/pose_landmarker.task
EDGE_QUEUE_PATH=/var/lib/careconnect-edge/events.sqlite3
# Optional, trusted artifact trained with research.train_activity:
# EDGE_ACTIVITY_MODEL=/opt/careconnect-edge/models/activity-model.joblib
