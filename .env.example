# CareConnect Environment Configuration
# Copy this file to .env and fill in your API keys

# Server-only Google Cloud Healthcare NLP configuration.
# The Firebase Admin service account needs permission to call Healthcare NLP.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1

# Server-only Google Cloud Vision face detection. Leave blank until configured.
# Preferred: absolute path to a private Google OAuth credential JSON file.
# Fallback order: GOOGLE_APPLICATION_CREDENTIALS, FIREBASE_SERVICE_ACCOUNT_KEY.
# Enable vision.googleapis.com and billing on the chosen Google Cloud project.
FACE_VISION_CREDENTIALS=
FACE_VISION_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=

# Server-only Gemini API (prescriptions and meal planning).
# Never put provider secrets in VITE_ or EXPO_PUBLIC_ variables.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro

# Feature Flags
VITE_ENABLE_AI=true
VITE_ENABLE_CLOUD_NLP=false
VITE_ENABLE_GEMINI_VERIFICATION=true
VITE_ENABLE_MEAL_SUGGESTIONS=true

# Browser and mobile prescription inference use the authenticated Express relay.
# Direct Python service traffic stays private; never use a VITE_ token variable.
DONUT_API_URL=http://127.0.0.1:8000
DONUT_INTERNAL_TOKEN=
DONUT_HOST=127.0.0.1
DONUT_MAX_IMAGE_PIXELS=16000000
DONUT_MAX_PENDING_INFERENCES=2
DONUT_MAX_CONCURRENT_INFERENCES=1
DONUT_QUEUE_TIMEOUT_SEC=180
VITE_ENABLE_CUSTOM_MODEL=false
VITE_ENSEMBLE_MODE=weighted_vote
VITE_PREFER_DONUT_OCR=false

# Optional timeout tuning (milliseconds)
VITE_DONUT_PREDICT_TIMEOUT_MS=120000
VITE_ENSEMBLE_DONUT_TIMEOUT_MS=45000
VITE_ENSEMBLE_GEMINI_TIMEOUT_MS=180000

# ──────────────────────────────────────────────
# Firebase Web Config (from Firebase Console → Project Settings → General → Your apps)
# ──────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Local dev safety switch: when omitted/true, skip browser Firebase Storage uploads on localhost
# to avoid noisy CORS failures while DB save continues. Set to false to force upload testing.
VITE_DISABLE_FIREBASE_STORAGE_UPLOAD=true

# ──────────────────────────────────────────────
# MySQL Database
# ──────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=careconnect
# For remote MySQL: server certificate CA path. Never disable certificate checking.
MYSQL_SSL_CA=

# ──────────────────────────────────────────────
# Express API Backend
# ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Firebase Admin service-account JSON file path (required for protected API access).
# Keep credentials local; never commit the service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Mobile apps: set the same API origin in each app's local .env.
# Physical phones require a reachable LAN IP or HTTPS endpoint, not localhost.
# EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:3001/api

# Monitoring derived-event retention. Raw video is never stored by the edge service.
MONITORING_RETENTION_DAYS=30
# Enable only after registering physical devices and configuring EAS FCM/APNs credentials.
# Sending remains disabled unless this exact value is true.
PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUSH_PROJECT_IDS=
EXPO_ACCESS_TOKEN=
MEDICATION_ESCALATION_MINUTES=30
NOTIFICATION_WORKER_INTERVAL_MS=15000
